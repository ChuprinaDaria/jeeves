# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
DB_NAME=concierge
DB_USER=concierge
DB_PASS=concierge
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# OpenAI / LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Qdrant vector store
USE_QDRANT=True
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=concierge_embeddings

# Platform URLs
SITE_URL=http://localhost:8000
CLIENT_PORTAL_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Optional iframe allowed hosts (comma-separated)
IFRAME_ALLOWED_HOSTS=localhost

# Meta / WhatsApp Business API (optional — leave blank if unused)
META_WABA_ID=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
