# API Configuration
VITE_API_URL=http://localhost:8000/api

# Stripe (for payments)
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# Chrome Extension (populate after uploading to Chrome Web Store,
# or leave blank when running in developer mode)
VITE_CONCIERGE_EXTENSION_ID=

# Optional: override the extension download URL shown in the dashboard
# VITE_EXTENSION_DOWNLOAD_URL=/static/extensions/concierge-chrome-extension.zip

# Optional: external support widget URL (leave empty to disable)
# VITE_SUPPORT_WIDGET_URL=

# Environment
VITE_ENV=development
