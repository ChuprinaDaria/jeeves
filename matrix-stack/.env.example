# ============================================
# Matrix Stack Environment Variables
# Copy to .env and fill in values
# ============================================

# PostgreSQL passwords
POSTGRES_SYNAPSE_PASSWORD=change_me_synapse_password
POSTGRES_MAS_PASSWORD=change_me_mas_password
POSTGRES_SLIDING_PASSWORD=change_me_sliding_password
POSTGRES_MAUTRIX_PASSWORD=change_me_mautrix_password

# mautrix-whatsapp provisioning secret
# Must match the value in Django admin (WhatsApp Bridge Config)
WHATSAPP_PROVISIONING_SECRET=change_me_provisioning_secret

# Sliding Sync
SLIDING_SYNC_SECRET=change_me_sliding_sync_secret

# LiveKit
LIVEKIT_API_KEY=change_me_livekit_key
LIVEKIT_API_SECRET=change_me_livekit_secret
