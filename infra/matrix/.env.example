# Matrix homeserver
MATRIX_DOMAIN=matrix.lazysoft.example.com
SYNAPSE_DB_PASSWORD=change_me_strong_password

# Generated after `docker compose run --rm synapse generate` (first run)
# and `register_new_matrix_user` (see docker-compose.yml).
# These values land in backend/.env so the mcp_matrix server can authenticate.
# MATRIX_HOMESERVER_URL=https://matrix.lazysoft.example.com
# MATRIX_BOT_USER_ID=@jeeves-bot:matrix.lazysoft.example.com
# MATRIX_BOT_TOKEN=syt_xxx
