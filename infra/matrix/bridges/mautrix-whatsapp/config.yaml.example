# mautrix-whatsapp — minimal config.
# Full template: https://github.com/mautrix/whatsapp/blob/main/example-config.yaml
# Generate registration.yaml: `docker compose run --rm mautrix-whatsapp -g -r /data/registration.yaml -c /data/config.yaml`

homeserver:
  address: http://synapse:8008
  domain: matrix.lazysoft.example.com
  software: standard

appservice:
  address: http://mautrix-whatsapp:29318
  hostname: 0.0.0.0
  port: 29318
  database:
    type: sqlite3-fk-wal
    uri: file:/data/mautrix-whatsapp.db?_txlock=immediate
  id: whatsapp
  bot:
    username: whatsappbot
    displayname: WhatsApp bridge bot
  as_token: GENERATE_ME
  hs_token: GENERATE_ME

bridge:
  username_template: "whatsapp_{{.}}"
  displayname_template: "{{or .FullName .PushName .JID}} (WA)"
  personal_filtering_spaces: true
  delivery_receipts: true
  message_status_events: true
  message_error_notices: true

  permissions:
    "*": relay
    "matrix.lazysoft.example.com": user
    "@jeeves-bot:matrix.lazysoft.example.com": admin

logging:
  min_level: info
  writers:
    - type: stdout
      format: pretty-colored
